<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat lineage is REQUIRED: MainActivity is an AppCompatActivity (for per-app
         locale switching), and it throws at onCreate under a non-AppCompat theme. -->
    <style name="Theme.JewelJester" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/jewel_deep</item>
    </style>
</resources>
