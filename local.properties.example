# Copy to local.properties and fill in. Do NOT commit local.properties.

# Adjust application token (Adjust dashboard -> your app).
ADJUST_APP_TOKEN=
# Keitaro campaign link. Must start with http:// or https:// or the install goes White forever.
OFFER_BASE_URL=
# Campaign group shape: aso (default) or prily (sub1 also goes into the path).
OFFER_ROUTING=aso
# base64 of google-services.json (Firebase). Empty = builds with a stub and NO working push.
GOOGLE_SERVICES_JSON=

# Optional: SDK location if ANDROID_HOME is not exported.
# sdk.dir=/Users/you/Library/Android/sdk
